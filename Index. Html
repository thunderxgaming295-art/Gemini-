<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A Little World for Priyanka 💜</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
  --bg:#080713;
  --pink:#ff6fce;
  --blue:#75caff;
  --purple:#a68aff;
  --card:#151329;
  --text:#fff;
  --muted:#b8b2d6;
}

body{
  background:var(--bg);
  color:var(--text);
  font-family:Arial,sans-serif;
  overflow-x:hidden;
}

button,input{font:inherit}
button{cursor:pointer}

/* INTRO */

#intro{
  height:100vh;
  min-height:550px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  position:relative;
  overflow:hidden;
  background:
    radial-gradient(ellipse at 50% 40%,#392050,#11102b 50%,#05040c);
}

#stars{
  position:absolute;
  inset:0;
  pointer-events:none;
}

.star{
  position:absolute;
  color:#fff;
  animation:twinkle 2s infinite alternate;
}

@keyframes twinkle{
  to{
    opacity:.15;
    transform:scale(.5);
  }
}

.introHeart{
  font-size:65px;
  animation:beat 1.5s infinite;
}

@keyframes beat{
  50%{transform:scale(1.15)}
}

.introTitle{
  font-size:clamp(35px,9vw,76px);
  font-weight:900;
  background:linear-gradient(90deg,#8be4ff,#ff78d7,#c7a0ff);
  color:transparent;
  background-clip:text;
  margin:15px;
}

.introSub{
  color:#d2c9ed;
  letter-spacing:3px;
  font-size:12px;
}

.startBtn{
  margin-top:40px;
  padding:15px 30px;
  border-radius:40px;
  border:1px solid #e8a1ff;
  background:linear-gradient(100deg,#9b42b9,#4947a8);
  color:white;
  box-shadow:0 0 30px #a04be555;
  animation:pulse 1.5s infinite;
}

@keyframes pulse{
  50%{transform:scale(1.05)}
}

/* APP */

#app{
  display:none;
  min-height:100vh;
  padding:25px 20px 100px;
}

.topline{
  display:flex;
  justify-content:space-between;
  gap:10px;
  font-size:12px;
  color:#b6b1db;
}

.header{
  text-align:center;
  padding:25px 0;
}

.header h1{
  font-size:clamp(23px,5vw,38px);
}

.header p{
  color:var(--muted);
  margin-top:10px;
}

.page{
  display:none;
  animation:fade .35s ease;
}

.page.active{
  display:block;
}

@keyframes fade{
  from{
    opacity:0;
    transform:translateY(10px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

.container{
  max-width:850px;
  margin:auto;
}

.card{
  background:linear-gradient(145deg,#1b1733,#101021);
  border:1px solid #3c315a;
  border-radius:20px;
  padding:23px;
  margin:15px 0;
  box-shadow:0 10px 35px #0004;
}

h2{
  font-size:24px;
  margin-bottom:15px;
}

p{
  line-height:1.7;
}

.muted{
  color:var(--muted);
}

.hero{
  text-align:center;
  padding:35px 10px;
}

.hero h1{
  font-size:clamp(43px,10vw,85px);
  background:linear-gradient(90deg,#86dfff,#ff83d7);
  color:transparent;
  background-clip:text;
  margin:12px 0;
}

.hero p{
  color:#c6bddf;
}

.heroHeart{
  font-size:50px;
  animation:beat 1.5s infinite;
}

.btn{
  padding:12px 20px;
  border-radius:30px;
  border:1px solid #b66ae6;
  color:white;
  background:linear-gradient(100deg,#8435a9,#414aab);
  margin:10px 5px 0 0;
  transition:.2s;
}

.btn:hover{
  transform:translateY(-3px);
  box-shadow:0 0 20px #a45ddd55;
}

.btn.secondary{
  background:#201b38;
  border-color:#51436f;
}

.grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:15px;
}

.bigText{
  font-size:clamp(20px,4vw,29px);
  line-height:1.8;
  color:#ffd0f2;
  text-align:center;
  padding:20px 0;
}

.divider{
  height:1px;
  background:#39314f;
  margin:20px 0;
}

/* FRIENDSHIP BADGE */

.friendBadge{
  text-align:center;
  padding:18px;
  margin:15px 0;
  border-radius:16px;
  background:linear-gradient(120deg,#251c42,#17152d);
  border:1px solid #49396c;
}

.friendBadge strong{
  color:#ff9bdd;
}

/* MEMORY WALL */

.memoryGrid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.memory{
  min-height:145px;
  border:1px solid #40345f;
  background:linear-gradient(145deg,#282044,#17152e);
  border-radius:16px;
  padding:18px;
  text-align:center;
  display:flex;
  flex-direction:column;
  justify-content:center;
  cursor:pointer;
  transition:.25s;
}

.memory:hover{
  transform:translateY(-5px);
  border-color:var(--pink);
}

.memory span{
  font-size:35px;
  margin-bottom:12px;
}

.memory p{
  color:#bdb6d5;
  margin-top:8px;
  font-size:13px;
}

/* QUIZ */

.answerBtn{
  display:block;
  width:100%;
  text-align:left;
  background:#201d3a;
  border:1px solid #40375e;
  color:white;
  padding:15px;
  border-radius:12px;
  margin:10px 0;
}

.answerBtn:hover{
  background:#3a2a56;
}

.answerBtn:disabled{
  opacity:.7;
}

.progress{
  height:9px;
  background:#2c2545;
  border-radius:20px;
  overflow:hidden;
  margin:15px 0;
}

.fill{
  height:100%;
  width:0;
  background:linear-gradient(90deg,#76d9ff,#ff6fce);
  transition:.3s;
}

/* BUCKET LIST */

.plan{
  display:flex;
  align-items:center;
  gap:12px;
  padding:15px;
  background:#201b35;
  border-radius:12px;
  margin:10px 0;
}

.plan input{
  width:20px;
  height:20px;
  accent-color:#ff6fce;
}

.plan.done{
  background:#19372f;
  color:#b7ebd2;
}

input[type=text]{
  width:100%;
  padding:14px;
  border-radius:12px;
  background:#0a0918;
  border:1px solid #51416c;
  color:white;
}

/* SECRET */

.secret{
  text-align:center;
  padding:25px 5px;
}

.lock{
  font-size:85px;
  cursor:pointer;
  transition:.3s;
}

.lock:hover{
  transform:scale(1.12);
}

#secretMessage{
  display:none;
}

/* NAV */

.bottomNav{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  height:75px;
  display:flex;
  justify-content:center;
  align-items:center;
  gap:7px;
  background:#0b0918f5;
  border-top:1px solid #332849;
  padding:8px;
  z-index:50;
}

.navBtn{
  flex:1;
  max-width:180px;
  height:55px;
  border:0;
  border-radius:12px;
  background:#201a35;
  color:#b9b0d8;
  font-size:11px;
  transition:.2s;
}

.navBtn.active{
  background:linear-gradient(100deg,#a445ba,#5146b5);
  color:white;
}

footer{
  text-align:center;
  color:#77728f;
  font-size:12px;
  margin-top:30px;
}

/* FLOATING PARTICLES */

#particles{
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:100;
  overflow:hidden;
}

.float{
  position:absolute;
  bottom:-30px;
  animation:rise 4s linear forwards;
}

@keyframes rise{
  to{
    transform:translateY(-110vh) rotate(40deg);
    opacity:0;
  }
}

#toast{
  position:fixed;
  bottom:90px;
  left:50%;
  transform:translateX(-50%);
  display:none;
  background:#292044;
  border:1px solid #b66ae6;
  padding:13px 20px;
  border-radius:25px;
  z-index:120;
  text-align:center;
  max-width:90%;
}

/* MOBILE */

@media(max-width:550px){

  #app{
    padding:15px 12px 100px;
  }

  .grid{
    grid-template-columns:1fr;
  }

  .memoryGrid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .card{
    padding:17px;
  }

  .bottomNav{
    gap:4px;
  }

  .navBtn{
    font-size:9px;
    padding:3px;
  }
}
</style>
</head>

