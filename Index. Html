  .classList.add('active');

  window.scrollTo({
    top:0,
    behavior:'smooth'
  });

}


/* =========================
   TOAST
========================= */

function toast(msg){

  const t=document.getElementById('toast');

  t.textContent=msg;

  t.style.display='block';

  clearTimeout(window.toastTimer);

  window.toastTimer=setTimeout(()=>{
    t.style.display='none';
  },2300);

}


