/* =========================
   FRIENDSHIP QUIZ
========================= */

const questions=[

 {
  q:"What makes a good friendship?",
  a:[
    "Trust & laughter",
    "Never talking",
    "Only homework"
  ],
  c:0
 },

 {
  q:"What should good friends collect?",
  a:[
    "Good memories",
    "More stress",
    "Boring days"
  ],
  c:0
 },

 {
  q:"What's important between friends?",
  a:[
    "Being real & supportive",
    "Ignoring each other",
    "Always arguing"
  ],
  c:0
 },

 {
  q:"What's the vibe of this website?",
  a:[
    "A friendship gift 💜",
    "A maths exam",
    "A boring lecture"
  ],
  c:0
 }

];

let qi=0;
let score=0;
let answered=false;


function renderQuiz(){

  answered=false;

  const q=questions[qi];

  document.getElementById('question')
  .textContent=
  `Question ${qi+1}/${questions.length}: ${q.q}`;

  document.getElementById('answers')
  .innerHTML='';

  document.getElementById('quizResult')
  .textContent='';

  document.getElementById('quizProgress')
  .style.width=
  (qi/questions.length*100)+'%';


  q.a.forEach((a,i)=>{

    const b=document.createElement('button');

    b.className='answerBtn';

    b.textContent=a;

    b.onclick=()=>answer(i);

    document.getElementById('answers')
    .appendChild(b);

  });

}


function answer(i){

  if(answered)return;

  answered=true;

  if(i===questions[qi].c){

    score++;

    sound("success");

    document.getElementById('quizResult')
    .textContent=
    "Correct! You know this friendship well! 💜";

  }else{

    sound("click");

    document.getElementById('quizResult')
    .textContent=
    "Nice try! 😄";

  }

  document.getElementById('quizScore')
  .textContent=
  'Score: '+score;

  document.querySelectorAll('.answerBtn')
  .forEach(b=>b.disabled=true);

  qi++;

  setTimeout(()=>{

    if(qi<questions.length){

      renderQuiz();

    }else{

      sound("success");

      document.getElementById('question')
      .textContent=
      'Quiz completed! 🎉';

      document.getElementById('answers')
      .innerHTML='';

      document.getElementById('quizProgress')
      .style.width='100%';

      document.getElementById('quizResult')
      .textContent=
      `Final score: ${score}/${questions.length} 💜`;

    }

  },900);

}


function restartQuiz(){

  sound("click");

  qi=0;

  score=0;

  document.getElementById('quizScore')
  .textContent='Score: 0';

  renderQuiz();

}


/* =========================
   HEART COLLECTOR
========================= */

let heartCount=0;

function catchHeart(){

  heartCount++;

  sound("click");

  document.getElementById('heartCount')
  .textContent=
  heartCount+' 💜';

  if(heartCount%10===0){

    sound("success");

    toast(
      '10 hearts collected! 🎉'
    );

  }

  hearts();

}


/* =========================
   FUTURE PLANS
========================= */

let plans=[

 {
  text:'Have a movie night 🍿',
  done:false
 },

 {
  text:'Take some funny photos 📸',
  done:false
 },

 {
  text:'Try a new café ☕',
  done:false
 },

 {
  text:'Go somewhere fun 🌍',
  done:false
 },

 {
  text:'Have one completely random day 😂',
  done:false
 },

 {
  text:'Make more unforgettable memories 💜',
  done:false
 }

];


function renderPlans(){

  const box=document.getElementById('plans');

  box.innerHTML='';

  plans.forEach(p=>{

    const label=document.createElement('label');

    label.className=
    'plan'+(p.done?' done':'');

    const cb=document.createElement('input');

    cb.type='checkbox';

    cb.checked=p.done;

    cb.onchange=()=>{

      p.done=cb.checked;

      sound("click");

      renderPlans();

    };


    const span=document.createElement('span');

    span.textContent=p.text;

    label.append(cb,span);

    box.appendChild(label);

  });


  const done=
  plans.filter(p=>p.done).length;

  document.getElementById('planCount')
  .textContent=
  `${done} / ${plans.length} plans completed`;

  document.getElementById('planProgress')
  .style.width=
  (plans.length?
   done/plans.length*100:
   0)+'%';

}


function addPlan(){

  const input=
  document.getElementById('planInput');

  const val=input.value.trim();

  if(!val){

    sound("click");

    return toast(
      'Write something first! ✨'
    );

  }

  plans.push({
    text:val,
    done:false
  });

  input.value='';

  sound("success");

  renderPlans();

  toast(
    'Added to the list! 💜'
  );

}


/* =========================
   SECRET
========================= */

function unlock(){

  sound("success");

  document.getElementById('lock')
  .textContent='💜';

  document.getElementById('secretMessage')
  .style.display='block';

  hearts();

}


/* =========================
   FLOATING HEARTS
========================= */

function hearts(){

  for(let i=0;i<15;i++){

    const el=document.createElement('span');

    el.className='float';

    el.textContent=[
      '💜',
      '💗',
      '✨',
      '🌷'
    ][
      Math.floor(Math.random()*4)
    ];

    el.style.left=
    Math.random()*100+'%';

    el.style.fontSize=
    (15+Math.random()*22)+'px';

    document.getElementById('particles')
    .appendChild(el);

    setTimeout(()=>{
      el.remove();
    },4000);

  }

}


/* =========================
   CLOCK
========================= */

setInterval(()=>{

  document.getElementById('clock')
  .textContent=
  new Date().toLocaleTimeString([],{
    hour:'2-digit',
    minute:'2-digit',
    second:'2-digit'
  })+' 💜';

},1000);


/* INITIALIZE */

renderQuiz();
renderPlans();

</script>

